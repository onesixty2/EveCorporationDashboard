<Application x:Class="EveCorporationDashboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="AppFont">pack://application:,,,/Assets/#Oxanium, Segoe UI</FontFamily>

        <!-- Theme brushes; ThemeManager swaps these for dark mode. Light values here. -->
        <SolidColorBrush x:Key="ThWindowBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThPanelBg" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="ThCardBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThText" Color="#111111"/>
        <SolidColorBrush x:Key="ThTextDim" Color="#595959"/>
        <SolidColorBrush x:Key="ThGridBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThGridLine" Color="#D6D6D6"/>
        <SolidColorBrush x:Key="ThHeaderBg" Color="#EDEDED"/>
        <SolidColorBrush x:Key="ThBtnBg" Color="#EDEDED"/>
        <SolidColorBrush x:Key="ThBtnHover" Color="#DDE8F3"/>
        <SolidColorBrush x:Key="ThBtnPressed" Color="#C8D9EA"/>
        <SolidColorBrush x:Key="ThBtnBorder" Color="#ABABAB"/>
        <SolidColorBrush x:Key="ThFieldBg" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ThAccent" Color="#B87A1F"/>
        <SolidColorBrush x:Key="StAwol" Color="#FFDBDB"/>
        <SolidColorBrush x:Key="StLoa" Color="#FFE9CF"/>
        <SolidColorBrush x:Key="StLow" Color="#FFF8CE"/>
        <SolidColorBrush x:Key="StNoPart" Color="#FFE9A8"/>
        <SolidColorBrush x:Key="StInactive" Color="#FFD59B"/>
        <SolidColorBrush x:Key="StAfk" Color="#FFC4C4"/>
        <SolidColorBrush x:Key="StActive" Color="#DFF5DF"/>
        <SolidColorBrush x:Key="StUnmapped" Color="#EBE3F5"/>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource ThGridBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="RowBackground" Value="{DynamicResource ThGridBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThGridLine}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource ThGridLine}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource ThGridLine}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ThHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThGridLine}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource ThWindowBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThGridLine}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
        </Style>
        <Style TargetType="TabItem">
            <!-- Tab CONTENT inherits its foreground from the TabItem, so this must be themed
                 or everything inside the tabs falls back to system black. -->
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Background="{DynamicResource ThPanelBg}"
                                BorderBrush="{DynamicResource ThGridLine}" BorderThickness="1,1,1,0"
                                Margin="0,0,2,0" Padding="12,5" CornerRadius="3,3,0,0">
                            <ContentPresenter ContentSource="Header"
                                              TextElement.Foreground="{DynamicResource ThText}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThWindowBg}"/>
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource ThAccent}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource ThAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource ThPanelBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Background" Value="{DynamicResource ThBtnBg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBtnBorder}"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="2" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThBtnHover}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ThAccent}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ThBtnPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ThFieldBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThBtnBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource ThText}"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="{DynamicResource ThBtnBg}"
                                                BorderBrush="{DynamicResource ThBtnBorder}"
                                                BorderThickness="1" CornerRadius="2">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,9,0" Data="M0,0 L8,0 L4,5 Z"
                                                  Fill="{DynamicResource ThTextDim}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{DynamicResource ThAccent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Margin="8,3,26,3" HorizontalAlignment="Left"
                                              VerticalAlignment="Center" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom"
                                   AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource ThCardBg}"
                                        BorderBrush="{DynamicResource ThBtnBorder}" BorderThickness="1"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource ThText}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="Transparent" Padding="8,4">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ThBtnHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
